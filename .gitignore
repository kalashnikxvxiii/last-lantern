dist/
desktop/node_modules/
desktop/game/
desktop/build/
node_modules/
godot/.godot/
.superpowers/
start.sh

# Markdown files are ignored (keeps third-party/AI-generated notes and design
# docs out of the repo). Only the files below are tracked.
*.md
!README.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!AGENTS.md
!CLAUDE.md
!.github/**/*.md
docs/*
!docs/playtest-checklist.md
!docs/porting-conventions.md
!docs/enemies.md
!docs/enemies.pdf
!docs/enemies/

# Obsidian vault. Unlike the docs above, notes/ and .obsidian/ are shared team
# notes, opened with Obsidian (see notes/Home.md). Per-user state stays local.
!notes/
!notes/**/*.md
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json
.obsidian/cache/
.obsidian/.trash/