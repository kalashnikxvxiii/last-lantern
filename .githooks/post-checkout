#!/bin/sh
# Branch switches only ($3 = 1), not checkouts of single files.
[ "$3" = "1" ] || exit 0
# A rebase also checks out branches: post-rewrite imports once at its end.
[ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ] && exit 0
exec "$(dirname "$0")/post-merge"
